# Copie este arquivo para ".env" (ignorado pelo git) e ajuste so o que precisar.
# O docker compose le o ".env" da raiz automaticamente.

# Porta do host para o postgres-core. Padrao 5432. Troque se outro Postgres ja usa essa porta
# (ex.: um PostgreSQL instalado no Windows). Se mudar, aponte tambem o alocacreche-core:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/alocacreche
# (5433 ja e usado pelo postgres-relatorios.)
POSTGRES_CORE_PORT=5434

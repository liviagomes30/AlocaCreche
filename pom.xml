<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>org.alocacreche</groupId>
    <artifactId>alocacreche-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AlocaCreche - Parent</name>
    <description>
        Reactor raiz do AlocaCreche. Agrega o monolito modular (alocacreche-core),
        o Gateway (alocacreche-gateway) e o unico microsservico real (alocacreche-relatorios).
        Ver docs/adr/0001-fundacao-arquitetural.md e docs/adr/0002-versoes-stack-e-scaffold-inicial.md.
    </description>

    <modules>
        <module>alocacreche-core</module>
        <module>alocacreche-gateway</module>
        <module>alocacreche-relatorios</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.proc>full</maven.compiler.proc>
        <!--
            Spring Boot 3.5.x foi escolhido em vez da linha 4.x (estavel desde nov/2025)
            porque o Sa-Token, dependencia obrigatoria de seguranca deste projeto, ainda
            nao publica um starter dedicado para Spring Boot 4 no Maven Central (verificado
            em setembro/2026 — so existe sa-token-spring-boot3-starter). Ver ADR 0002 para o
            racional completo e o gatilho de quando revisitar essa escolha.
        -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <sa-token.version>1.44.0</sa-token.version>
        <lombok.version>1.18.48</lombok.version>
        <postgresql.version>42.7.12</postgresql.version>
    </properties>
</project>
